{
  "name": "@sctg/openclaw-coach",
  "version": "2.2.1",
  "description": "AI endurance and recovery coach plugin for OpenClaw: documented physiological models (HRV baseline, recovery, sleep, training load, early warning) computed on Garmin Connect data via garmin-cli, with a coaching skill.",
  "icon": "assets/logo.png",
  "type": "module",
  "license": "MIT",
  "author": "Ronan LE MEILLAT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sctg-development/openclaw-coach.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills",
    "docs",
    "examples",
    "assets",
    "!assets/logo.ai",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "typebox": "1.3.17",
    "@sctg/garmin-ts-client": "^0.2.0"
  },
  "optionalDependencies": {
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "openclaw": ">=2026.8.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.2",
      "minGatewayVersion": "2026.8.2"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
