{
  "id": "coach",
  "name": "AI Coach",
  "description": "Endurance coaching skill backed by Garmin Connect training-signal tools (via garmin-cli's gc CLI).",
  "requiresPlugins": [],
  "skills": ["skills/coach"],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["coach_garmin_digest", "coach_activity_deep_dive"]
  },
  "toolMetadata": {
    "coach_garmin_digest": {
      "optional": false,
      "sideEffecting": false,
      "replaySafe": true
    },
    "coach_activity_deep_dive": {
      "optional": false,
      "sideEffecting": false,
      "replaySafe": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gcBinary": {
        "type": "string",
        "description": "Path to the garmin-cli `gc` binary. Defaults to \"gc\" (resolved from PATH)."
      }
    }
  }
}
